seal ui 1
theme ui/puzzle.sealtheme
panel Screen
  anchor 0 0 1 1
  color #00000099
  panel Card
    anchor 0.5 0.5 0.5 0.5
    offset -140 -120 140 120
    vbox Menu
      anchor 0 0 1 1
      padding 12
      label Title
        text Paused
        align center
        font_size 26
      button Resume
      button PauseOptions
        text Options
      button PauseQuit
        text Quit to Menu