seal ui 1
theme ui/puzzle.sealtheme
panel Screen
  anchor 0 0 1 1
  color #1A1A2EFF
  vbox Menu
    anchor 0.5 0.5 0.5 0.5
    offset -200 -170 200 170
    label Title
      text Options
      align center
      font_size 28
    label MusicLabel
      text Music Volume
    slider MusicVol
      min 0
      max 10
      value 8
    label SoundLabel
      text Sound Volume
    slider SoundVol
      min 0
      max 10
      value 8
    button RebindBtn
      text Rebind Controls
    button OptionsBack
      text Back