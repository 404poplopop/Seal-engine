# Game rules and AI orders: hosts without them ignore the orders and read defaults.
schema_version = 1
seal_graph = "rules"
vars = []
nodes = [
  { id = 1, kind = "event", name = "start" },
  { id = 2, kind = "self" },
  { id = 3, kind = "possess", defaults = { index = 0 } },
  { id = 4, kind = "spawn_player", defaults = { index = 0 } },
  { id = 5, kind = "add_score", defaults = { name = "coins", amount = 3 } },
  { id = 6, kind = "set_game_state", defaults = { state = "won" } },
  { id = 7, kind = "ai_move_to", defaults = { target = [1.0, 0.0, 2.0], speed = 3.0 } },
  { id = 8, kind = "ai_chase", defaults = { speed = 2.0 } },
  { id = 9, kind = "ai_patrol", defaults = { a = [0.0, 0.0, 0.0], b = [4.0, 0.0, 0.0], speed = 1.0 } },
  { id = 10, kind = "ai_stop" },
  { id = 11, kind = "score", defaults = { name = "coins" } },
  { id = 12, kind = "to_str", type = "int" },
  { id = 13, kind = "game_state" },
  { id = 14, kind = "concat" },
  { id = 15, kind = "ai_arrived" },
  { id = 16, kind = "to_str", type = "bool" },
  { id = 17, kind = "concat" },
  { id = 18, kind = "log" },
]
links = [
  "1.then -> 3.in", "2.out -> 3.entity", "3.then -> 4.in", "4.then -> 5.in", "5.then -> 6.in",
  "6.then -> 7.in", "2.out -> 7.entity", "7.then -> 8.in", "2.out -> 8.entity", "2.out -> 8.target",
  "8.then -> 9.in", "2.out -> 9.entity", "9.then -> 10.in", "2.out -> 10.entity",
  "10.then -> 18.in", "11.out -> 12.a", "12.out -> 14.a", "13.out -> 14.b",
  "2.out -> 15.entity", "15.out -> 16.a", "14.out -> 17.a", "16.out -> 17.b", "17.out -> 18.message",
]
