# Per-entity motion with no branches, delays or variables, so its tick runs
# as a data-parallel kernel over every entity at once.
schema_version = 1
seal_graph = "swarm"
nodes = [
  { id = 1, kind = "event", name = "tick", params = [{ name = "dt", type = "float" }] },
  { id = 2, kind = "self" },
  { id = 3, kind = "world_get", component = "agent", field = "pos", type = "vec2" },
  { id = 4, kind = "world_get", component = "agent", field = "vel", type = "vec2" },
  { id = 5, kind = "scale" },
  { id = 6, kind = "add", type = "vec2" },
  { id = 7, kind = "world_set", component = "agent", field = "pos", type = "vec2" },
  { id = 8, kind = "world_get", component = "agent", field = "pos", type = "vec2" },
  { id = 9, kind = "vec2_x" },
  { id = 10, kind = "abs", type = "float" },
  { id = 11, kind = "compare", type = "float", op = "gt", defaults = { b = 10.0 } },
  { id = 12, kind = "neg", type = "vec2" },
  { id = 13, kind = "select", type = "vec2" },
  { id = 14, kind = "world_set", component = "agent", field = "vel", type = "vec2" },
  { id = 15, kind = "world_get", component = "agent", field = "bounces", type = "int" },
  { id = 16, kind = "select", type = "int", defaults = { a = 1, b = 0 } },
  { id = 17, kind = "add", type = "int" },
  { id = 18, kind = "world_set", component = "agent", field = "bounces", type = "int" },
  { id = 19, kind = "length" },
  { id = 20, kind = "world_set", component = "agent", field = "dist", type = "float" },
  { id = 21, kind = "sequence", count = 2 },
]
links = [
  "1.then -> 21.in",
  "21.then0 -> 7.in",
  "7.then -> 14.in",
  "14.then -> 18.in",
  "21.then1 -> 20.in",
  "2.out -> 3.entity",
  "2.out -> 4.entity",
  "2.out -> 7.entity",
  "2.out -> 8.entity",
  "2.out -> 14.entity",
  "2.out -> 15.entity",
  "2.out -> 18.entity",
  "2.out -> 20.entity",
  "4.out -> 5.v",
  "1.dt -> 5.s",
  "3.out -> 6.a",
  "5.out -> 6.b",
  "6.out -> 7.value",
  "8.out -> 9.v",
  "9.out -> 10.a",
  "10.out -> 11.a",
  "4.out -> 12.a",
  "11.out -> 13.cond",
  "12.out -> 13.a",
  "4.out -> 13.b",
  "13.out -> 14.value",
  "11.out -> 16.cond",
  "15.out -> 17.a",
  "16.out -> 17.b",
  "17.out -> 18.value",
  "8.out -> 19.v",
  "19.out -> 20.value",
]
