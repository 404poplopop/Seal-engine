  { id = 11, kind = "branch" },
  { id = 12, kind = "neg", type = "vec2" },
  { id = 13, kind = "world_set", component = "mover", field = "vel", type = "vec2" },
  { id = 14, kind = "get", name = "bounces" },
  { id = 15, kind = "add", type = "int", defaults = { b = 1 } },
  { id = 16, kind = "set", name = "bounces" },
  { id = 17, kind = "sequence", count = 2 },
  { id = 18, kind = "delay", defaults = { seconds = 0.25 } },
  { id = 19, kind = "get", name = "visible" },
  { id = 20, kind = "not" },
  { id = 21, kind = "set", name = "visible" },
  { id = 22, kind = "get", name = "blinks" },
  { id = 23, kind = "add", type = "int", defaults = { b = 1 } },
  { id = 24, kind = "set", name = "blinks" },
  { id = 25, kind = "world_get", component = "mover", field = "pos", type = "vec2" },
]
