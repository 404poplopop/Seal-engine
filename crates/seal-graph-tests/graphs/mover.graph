# Moves its entity by velocity each tick, bounces off walls, blinks with delays.
schema_version = 1
seal_graph = "mover"
vars = [
  { name = "bounces", type = "int", default = 0 },
  { name = "blinks", type = "int", default = 0 },
  { name = "visible", type = "bool", default = true },
]
nodes = [
  { id = 1, kind = "event", name = "tick" },
  { id = 2, kind = "self" },
  { id = 3, kind = "world_get", component = "mover", field = "pos", type = "vec2" },
  { id = 4, kind = "world_get", component = "mover", field = "vel", type = "vec2" },
  { id = 5, kind = "scale" },
