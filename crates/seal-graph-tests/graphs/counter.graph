# Counts hits, accumulates time and announces when it is done.
schema_version = 1
seal_graph = "counter"
vars = [
  { name = "count", type = "int", default = 0 },
  { name = "total", type = "float", default = 0.0 },
  { name = "announced", type = "bool", default = false },
]
nodes = [
  { id = 1, kind = "event", name = "start" },
  { id = 2, kind = "log", defaults = { message = "counter started" } },
  { id = 10, kind = "event", name = "tick" },
  { id = 11, kind = "get", name = "total" },
  { id = 12, kind = "add", type = "float" },
  { id = 13, kind = "set", name = "total" },
  { id = 20, kind = "event", name = "hit", params = [{ name = "amount", type = "int" }] },
  { id = 21, kind = "get", name = "count" },
  { id = 22, kind = "add", type = "int" },
  { id = 23, kind = "set", name = "count" },
  { id = 24, kind = "compare", type = "int", op = "ge", defaults = { b = 10 } },
  { id = 25, kind = "not" },
  { id = 26, kind = "get", name = "announced" },
  { id = 27, kind = "and" },
  { id = 28, kind = "branch" },
  { id = 29, kind = "to_str", type = "int" },
  { id = 30, kind = "concat", defaults = { a = "done at " } },
  { id = 31, kind = "log" },
  { id = 32, kind = "set", name = "announced", defaults = { value = true } },
]
links = [
  "1.then -> 2.in",
  "10.then -> 13.in",
  "11.out -> 12.a",
  "10.dt -> 12.b",
  "12.out -> 13.value",
  "20.then -> 23.in",
  "21.out -> 22.a",
  "20.amount -> 22.b",
  "22.out -> 23.value",
  "23.then -> 28.in",
  "23.value -> 24.a",
  "26.out -> 25.a",
  "24.out -> 27.a",
  "25.out -> 27.b",
  "27.out -> 28.cond",
  "28.true -> 31.in",
  "21.out -> 29.a",
  "29.out -> 30.b",
  "30.out -> 31.message",
  "31.then -> 32.in",
]
